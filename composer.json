{
    "name": "crypty-php/core",
    "description": "Core library of the CryptyPHP Symfony bundle",
    "minimum-stability": "stable",
    "license": "GPL-3.0-only",
    "authors": [
        {
            "name": "Fabien BERNE",
            "email": "fabienberne0@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "symfony/config": "^7.0|^8.0",
        "symfony/dependency-injection": "^7.0|^8.0",
        "symfony/http-kernel": "^7.0|^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.0",
        "symfony/framework-bundle": "^7.0|^8.0",
        "symfony/yaml": "^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Crypty\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Crypty\\Core\\Tests\\": "tests/"
        }
    }
}
